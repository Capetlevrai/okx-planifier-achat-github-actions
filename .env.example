# Copiez ce fichier vers .env et remplissez-le. .env est ignoré par git.

# --- Identifiants OKX (Profil > API sur okx.com) ---
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# --- Environnement ---
# 1 = compte démo (simulated trading), 0 = compte réel
OKX_DEMO=1
# https://my.okx.com = Europe/EEA · https://www.okx.com = global
OKX_BASE_URL=https://my.okx.com

# --- Garde-fou ---
# 1 = simulation, aucun ordre transmis. Mettez 0 en connaissance de cause.
DRY_RUN=1
